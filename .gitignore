# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- tooling ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- data: regenerable with `nasa-space-ml fetch`, so it never ships ---
# The trained models and reports DO ship, so every published number stays checkable.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- run logs: `nasa-space-ml serve > logs_server.txt` during development; the training
# transcripts are useful locally and misleading in a repo, where a reader would take them
# for the record of how the shipped artifacts were made (reports/*/metrics.json is that) ---
logs_*.txt
server.log

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db
